{
  "forms": [
    {
      "id": "hishu",
      "name": "Hishu",
      "attributes": {},
      "size": 0,
      "speciesFactor": 0,
      "perception": 1,
      "firearmsDefense": false,
      "armorGeneral": 0,
      "armorBallistic": 0,
      "sourceId": "wtf-2ed",
      "source": "Werewolf: The Forsaken Second Edition",
      "page": 96,
      "description": "Hishu is the human form. Add +1 die to Perception rolls using wolf senses. Sheep's Clothing: attempts to pinpoint the Uratha in a crowd or pursue her through populated areas suffer her Primal Urge as a penalty.",
      "additionalPages": []
    },
    {
      "id": "dalu",
      "name": "Dalu",
      "attributes": {
        "Strength": 1,
        "Stamina": 1,
        "Manipulation": -1
      },
      "size": 1,
      "speciesFactor": 0,
      "perception": 2,
      "firearmsDefense": true,
      "armorGeneral": 0,
      "armorBallistic": 0,
      "sourceId": "wtf-2ed",
      "source": "Werewolf: The Forsaken Second Edition",
      "page": 96,
      "description": "Dalu adds Strength +1, Stamina +1, Manipulation −1 and Size +1. Claw attacks deal lethal damage to humans; successful bites in a grapple deal lethal damage. Apply Defense against Firearms. Perception using wolf senses gains +2 dice. Inflicts mild Lunacy. Badass Motherfucker: roll Presence + Primal Urge against the prey's Composure + Primal Urge; on success, those surrounding or protecting the prey back down or offer the prey up.",
      "additionalPages": [
        97
      ]
    },
    {
      "id": "gauru",
      "name": "Gauru",
      "attributes": {
        "Strength": 3,
        "Dexterity": 1,
        "Stamina": 2
      },
      "size": 2,
      "speciesFactor": 0,
      "perception": 3,
      "firearmsDefense": true,
      "armorGeneral": 0,
      "armorBallistic": 0,
      "sourceId": "wtf-2ed",
      "source": "Werewolf: The Forsaken Second Edition",
      "page": 97,
      "description": "Gauru adds Strength +3, Dexterity +1, Stamina +2 and Size +2. The form grants no innate Armor. Once per scene, remain in Gauru for Hishu Stamina + Primal Urge turns. Afterwards shift to Dalu or Urshul, or risk Kuruth: a reflexive Resolve + Composure success allows one more turn, then a shift to Dalu or Urshul and Wasu-Im; failure causes immediate Basu-Im. Regenerate all bashing and lethal damage each turn. Teeth and claws deal +2 lethal damage without needing a grapple and can also establish one; Initiative gains +3 when using them. Apply Defense against Firearms. Wolf-sense Perception gains +3 dice; sight of Gauru inflicts full Lunacy. Rage demands an attack each turn; if none is in reach, move toward an opponent or throw something, and if none exists attack whatever is available. Other actions require Resolve + Composure or Kuruth. Automatically fail Social rolls not based on Intimidation and Mental rolls not based on Perception or Resistance. Primal Fear forces lesser enemies into Down and Dirty combat unless protected by stronger opponents; in normal combat, foes use Dexterity or Wits for Defense without the usual Skill.",
      "additionalPages": []
    },
    {
      "id": "urshul",
      "name": "Urshul",
      "attributes": {
        "Strength": 2,
        "Dexterity": 2,
        "Stamina": 2,
        "Manipulation": -1
      },
      "size": 1,
      "speciesFactor": 3,
      "perception": 3,
      "firearmsDefense": true,
      "armorGeneral": 0,
      "armorBallistic": 0,
      "sourceId": "wtf-2ed",
      "source": "Werewolf: The Forsaken Second Edition",
      "page": 97,
      "description": "Urshul adds Strength +2, Dexterity +2, Stamina +2, Manipulation −1, Size +1 and species Speed factor +3. It cannot communicate with humans but speaks the First Tongue easily. Claws deal +1 lethal damage; bites deal +2 lethal damage without requiring a grapple and can establish one. Apply Defense against Firearms. Wolf-sense Perception gains +3 dice; inflicts moderate Lunacy. Weaken the Prey: once per scene, damaging prey with teeth or claws can inflict Arm Wrack, Leg Wrack or Knocked Down without a targeted attack.",
      "additionalPages": []
    },
    {
      "id": "urhan",
      "name": "Urhan",
      "attributes": {
        "Dexterity": 2,
        "Stamina": 1,
        "Manipulation": -1
      },
      "size": -1,
      "speciesFactor": 3,
      "perception": 4,
      "firearmsDefense": false,
      "armorGeneral": 0,
      "armorBallistic": 0,
      "sourceId": "wtf-2ed",
      "source": "Werewolf: The Forsaken Second Edition",
      "page": 97,
      "description": "Urhan adds Dexterity +2, Stamina +1, Manipulation −1, Size −1 and species Speed factor +3. It cannot communicate with humans and speaks only a few simple First Tongue words. Bites deal +1 lethal damage without a grapple and can establish one. Wolf-sense Perception gains +4 dice. Chase Down: spend 1 Essence to pre-empt another character's action with your own, replacing your normal action; competing pre-emption causes a Clash of Wills, and this cannot be used after acting in the turn. In a foot chase use Speed instead of Strength + Athletics.",
      "additionalPages": [
        98
      ]
    }
  ],
